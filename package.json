{
  "name": "figma-mcp-dsh",
  "version": "0.2.0",
  "description": "Read-only Figma design-source tools for DeepSeek Harness: inspect file structure, colors, typography and export images as native tools.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "src/",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "figma",
    "design",
    "mcp"
  ],
  "engines": {
    "node": ">=20"
  },
  "//peerDependencies": "The host supplies these at runtime and judges the dsh-* ranges. For `link:` development and the offline test suite this repository also needs matching copies; see CONTRIBUTING.md §1.",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5.0.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.2 <4.0.0-0"
  },
  "devDependencies": {
    "semver": "^7.8.5"
  },
  "scripts": {
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "check:layering": "node scripts/check-layering.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:test-counts": "node scripts/check-test-counts.mjs",
    "verify": "npm run check:bundle && npm run check:deps && npm run check:layering && npm run check:secrets && npm run check:test-counts",
    "test": "node scripts/run-tests.mjs",
    "test:core": "node scripts/run-tests.mjs test/core",
    "test:real": "node --env-file-if-exists=.env.local --test test/core/real-data.test.js test/core/p1-real-data.test.js",
    "prepublishOnly": "npm run verify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/N107meow/figma-mcp-dsh.git"
  },
  "bugs": {
    "url": "https://github.com/N107meow/figma-mcp-dsh/issues"
  },
  "homepage": "https://github.com/N107meow/figma-mcp-dsh#readme"
}
